# Copy to .env.production on the VPS. Never commit the filled-in file.
# Use a URL-encoded POSTGRES_PASSWORD in DATABASE_URL if it has special characters.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://kotova:replace-with-a-long-random-password@postgres:5432/kotova?schema=public

# Public HTTPS URL; configure your reverse proxy to forward to 127.0.0.1:3000.
APP_URL=https://kotova.812001.xyz
AUTH_URL=https://kotova.812001.xyz
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
APP_PORT=3000

# Point a dedicated DNS name at this VPS and proxy it through Caddy to
# 127.0.0.1:9000. Signed download URLs contain this public HTTPS host.
S3_ENDPOINT=https://s3.812001.xyz
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_BUCKET_NAME=replace-with-bucket-name
