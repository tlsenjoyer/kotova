# Copy this file to .env.local and replace the example values before running pnpm dev.

# Required: PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/kotova?schema=public"

# Required: Auth.js secret for signing/encrypting sessions.
# Generate a unique value with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Required for file uploads, downloads, and deletion: S3-compatible storage.
# The S3 client reads its endpoint and credentials when imported.
S3_ENDPOINT="https://your-s3-endpoint.example.com"
S3_ACCESS_KEY_ID="replace-with-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-secret-access-key"
S3_BUCKET_NAME="replace-with-bucket-name"

# Optional: Next.js sets NODE_ENV automatically (development or production).
# NODE_ENV=development

# Optional: port used for the local metadata URL; defaults to 3000.
# Set PORT in the shell when starting Next.js on a different port.
# PORT=3000

# Optional: Vercel provides this deployment hostname automatically.
# VERCEL_URL=your-project.vercel.app
